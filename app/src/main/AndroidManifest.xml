<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".ContinueApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Continue"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true">

        <!-- AdMob app ID — public identifier, safe in a public repo. Test ID by default
             until a real one lands (docs/09-PENDING-INPUTS.md). -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Continue"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Transparent bottom-sheet Activity — the full app never launches for a share.
             docs/05-TECH-ARCHITECTURE.md §Share Target implementation.

             Launch mode is deliberately `standard` (the default, so it isn't declared).
             `singleTask` was here and it is what made sharing from TikTok/YouTube feel like
             *leaving* those apps: singleTask forces the activity to become the root of its own
             task, so the system runs a task-switch animation and parks CONTINUE? in the
             foreground rather than drawing over the caller. With `standard` the activity is
             pushed onto the *sharing app's* task, so it reads as an overlay and Back lands the
             user exactly where they were. `taskAffinity=""` keeps it out of the main app task
             in the one case a caller does pass FLAG_ACTIVITY_NEW_TASK. -->
        <activity
            android:name=".feature.sharetarget.ShareTargetActivity"
            android:theme="@style/Theme.Continue.Transparent"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter android:label="@string/share_target_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter android:label="@string/share_target_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <!-- The friend loop's receiving end — docs/02-PRODUCT-SPEC.md §6.

                 A `https://<worker>/g/<igdbId>` link tapped in WhatsApp/Discord opens this
                 same sheet, so a game a friend sent is two taps from being in your pile. It
                 lands here rather than on MainActivity deliberately: the sheet already is the
                 "a game arrived from somewhere else, add it?" surface, and reusing it means
                 the friend loop inherits the whole degradation ladder (offline, unknown id,
                 already in the pile) instead of growing a second one.

                 `autoVerify` makes Android fetch
                 https://<worker>/.well-known/assetlinks.json at install time; if the signing
                 fingerprint there doesn't match, verification fails **silently** and these
                 links open a browser instead. Worth knowing that the failure is invisible —
                 see worker/src/routes/gameLink.ts, which serves that file.

                 The host is a placeholder fed from WORKER_BASE_URL in local.properties, so it
                 cannot drift from the host the app builds its links against. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${shareLinkHost}" android:pathPrefix="/g/" />
            </intent-filter>

            <!-- The custom scheme the landing page's `intent://` button targets — the fallback
                 for installs where App Links verification never took (an old Android, a
                 sideload, or a fingerprint not yet updated). Unverifiable by design, so it is
                 never the primary path and nothing is trusted from it that isn't also
                 validated on the https path: both funnel into the same id parse. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="continueapp" android:host="g" />
            </intent-filter>
        </activity>

        <!-- Share card image handoff — docs/02-PRODUCT-SPEC.md §6 "SHARE". -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
